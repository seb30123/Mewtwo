+ *
+ * @param[in,out] v         Pointer to the uint64_t array containing the bits.
+ */
+void vect_truncate(uint64_t *v) {
+    size_t orig_words = (PARAM_N + 63) / 64;
+    size_t new_full_words = PARAM_N1N2 / 64;
+    size_t remaining_bits = PARAM_N1N2 % 64;
